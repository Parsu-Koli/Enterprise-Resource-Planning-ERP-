@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">
            <i class="bi bi-person-workspace text-success me-2"></i>
            HR Dashboard
        </h2>
        <p class="text-muted">Manage recruitment, payroll & employees</p>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4">

        <!-- Job Openings -->
        <div class="col-md-6 col-lg-3">
            <a asp-action="JobOpenings" class="text-decoration-none">
                <div class="card hr-card shadow-sm border-0 h-100">
                    <div class="card-body text-center">
                        <div class="icon-box bg-primary text-white mb-3">
                            <i class="bi bi-briefcase-fill fs-4"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Job Openings</h5>
                        <p class="text-muted small">Manage job vacancies</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Applicants -->
        <div class="col-md-6 col-lg-3">
            <a asp-action="Applicants" class="text-decoration-none">
                <div class="card hr-card shadow-sm border-0 h-100">
                    <div class="card-body text-center">
                        <div class="icon-box bg-info text-white mb-3">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Applicants</h5>
                        <p class="text-muted small">View job applicants</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Payroll -->
        <div class="col-md-6 col-lg-3">
            <a asp-action="Payrolls" class="text-decoration-none">
                <div class="card hr-card shadow-sm border-0 h-100">
                    <div class="card-body text-center">
                        <div class="icon-box bg-warning text-white mb-3">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Payroll</h5>
                        <p class="text-muted small">Manage salaries</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Employees -->
        <div class="col-md-6 col-lg-3">
            <a asp-action="Employees" class="text-decoration-none">
                <div class="card hr-card shadow-sm border-0 h-100">
                    <div class="card-body text-center">
                        <div class="icon-box bg-danger text-white mb-3">
                            <i class="bi bi-person-badge-fill fs-4"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Employees</h5>
                        <p class="text-muted small">Manage employees</p>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>

<style>
    .hr-card {
        border-radius: 15px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .hr-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
        }

    .icon-box {
        width: 60px;
        height: 60px;
        margin: auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

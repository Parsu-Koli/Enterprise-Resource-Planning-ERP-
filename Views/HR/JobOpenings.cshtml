@model IEnumerable<ERP.Models.JobOpening>

@{
    ViewData["Title"] = "Job Openings";
}

<div class="container py-5">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-briefcase-fill me-2 text-primary"></i>
                Job Openings
            </h3>
            <p class="text-muted mb-0">Manage and monitor all job vacancies</p>
        </div>

        <a asp-action="CreateJob" class="btn btn-primary px-4">
            <i class="bi bi-plus-circle me-1"></i>
            Add Job
        </a>
    </div>

    <!-- Card Container -->
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Title</th>
                            <th>Experience</th>
                            <th>Description</th>
                            <th>Posted Date</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @job.JobTitle
                                </td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @job.ExperienceRequired yrs
                                    </span>
                                </td>

                                <td class="text-muted">
                                    @(job.Description.Length > 60
                                                                    ? job.Description.Substring(0, 60) + "..."
                                                                    : job.Description)
                            </td>

                                <td>
                                    @job.PostedDate.ToShortDateString()
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                </td>

                                <td class="text-center">

                                    <a asp-action="AddExam"
                                       asp-route-jobId="@job.JobId"
                                       class="btn btn-sm btn-warning me-2">
                                        <i class="bi bi-journal-plus"></i> Add Exam
                                    </a>

                                    <form asp-action="DeleteJobVacancy"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="jobid"
                                               value="@job.JobId" />

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to delete this job?');">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </form>

                                </td>
                            </tr>
                                                }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

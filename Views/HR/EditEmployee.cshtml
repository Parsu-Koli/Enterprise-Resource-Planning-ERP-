@model ERP.Models.Employee

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-lg border-0 rounded-4">

                <!-- Card Header -->
                <div class="card-header bg-gradient text-white p-4 rounded-top-4" style="background: linear-gradient(90deg, #1e3c72, #2a5298);">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Edit Employee
                    </h4>
                </div>

                <!-- Card Body -->
                <div class="card-body p-5">
                    <form asp-action="EditEmployee" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="EmployeeId" />

                        <div class="row mb-4">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-person text-primary me-2"></i>First Name
                                </label>
                                <input asp-for="FirstName" class="form-control shadow-sm" placeholder="Enter first name" />
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-person text-primary me-2"></i>Last Name
                                </label>
                                <input asp-for="LastName" class="form-control shadow-sm" placeholder="Enter last name" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-envelope text-primary me-2"></i>Email
                            </label>
                            <input asp-for="Email" type="email" class="form-control shadow-sm" placeholder="Enter email address" />
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-phone text-primary me-2"></i>Phone
                                </label>
                                <input asp-for="Phone" class="form-control shadow-sm" placeholder="Enter phone number" />
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-venus-mars text-primary me-2"></i>Gender
                                </label>
                                <select asp-for="Gender" class="form-select shadow-sm" required>
                                    <option value="">-- Select --</option>
                                    <option>Male</option>
                                    <option>Female</option>
                                    <option>Other</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-calendar-event text-primary me-2"></i>Birth Date
                            </label>
                            <input asp-for="BirthDate" type="date" class="form-control shadow-sm" />
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-diagram-3-fill text-primary me-2"></i>Department
                                </label>
                                <select asp-for="DepartmentId" class="form-select shadow-sm">
                                    <option value="">-- Select Department --</option>
                                    @foreach (var d in ViewBag.Departments)
                                    {
                                        <option value="@d.DepartmentId">@d.DepartmentName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-briefcase text-primary me-2"></i>Designation
                                </label>
                                <input asp-for="Designation" class="form-control shadow-sm" placeholder="Enter designation" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-cash-stack text-primary me-2"></i>Salary
                            </label>
                            <input asp-for="Salary" type="number" step="0.01" class="form-control shadow-sm" placeholder="Enter salary" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-calendar-check text-primary me-2"></i>Date of Joining
                            </label>
                            <input asp-for="DateOfJoining" type="date" class="form-control shadow-sm" />
                        </div>

                        <div class="d-flex justify-content-between mt-5">
                            <a asp-action="ViewEmployee" asp-route-id="@Model.EmployeeId" class="btn btn-outline-secondary shadow-sm px-4">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success shadow-sm px-4">
                                <i class="bi bi-check-circle me-1"></i> Update
                            </button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

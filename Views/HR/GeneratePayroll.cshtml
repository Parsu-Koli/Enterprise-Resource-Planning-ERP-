@model ERP.Models.Employee

@{
    ViewData["Title"] = "Generate Payroll";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">
                <i class="bi bi-cash-coin me-2"></i>
                Generate Payroll
            </h5>
        </div>

        <div class="card-body">
            <table class="table table-bordered align-middle">
                <tr>
                    <th style="width:30%">Employee Name</th>
                    <td>@Model.FirstName @Model.LastName</td>
                </tr>
                <tr>
                    <th>Designation</th>
                    <td>@Model.Designation</td>
                </tr>
                <tr>
                    <th>Basic Salary</th>
                    <td>₹ @Model.Salary</td>
                </tr>
                <tr>
                    <th>Allowances</th>
                    <td>₹ 2000</td>
                </tr>
                <tr>
                    <th>Deductions</th>
                    <td>₹ 500</td>
                </tr>
                <tr class="table-success fw-bold">
                    <th>Net Salary</th>
                    <td>₹ @(Model.Salary + 2000 - 500)</td>
                </tr>
            </table>

            <form asp-action="GeneratePayroll" method="post" class="mt-3">
                <input type="hidden" name="employeeId" value="@Model.EmployeeId" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Payrolls" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Cancel
                    </a>

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Generate Payroll
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@model IEnumerable<ERP.Models.PayRoll>

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">

        <!-- Card Header -->
        <div class="card-header bg-gradient-primary text-dark rounded-top-4 d-flex justify-content-between align-items-center" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.3);">
            <h4 class="mb-0">
                <i class="bi bi-cash-stack me-2"></i> Payroll Records
            </h4>
            <a asp-action="Employees" class="btn btn-light btn-sm shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Generate Payroll
            </a>
        </div>

        <!-- Card Body -->
        <div class="card-body p-4">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Employee</th>
                        <th>Basic</th>
                        <th>Allowances</th>
                        <th>Deductions</th>
                        <th>Net Salary</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Employee.FirstName @p.Employee.LastName</td>
                            <td>@p.BasicSalary.ToString("C")</td>
                            <td>@p.Allowances.ToString("C")</td>
                            <td>@p.Deductions.ToString("C")</td>
                            <td class="fw-bold text-success">@p.NetSalary.ToString("C")</td>
                            <td>@p.GeneratedDate.ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Card Footer -->
        <div class="card-footer text-center text-muted">
            &copy; @DateTime.Now.Year Your Company Name. All Rights Reserved.
        </div>
    </div>
</div>


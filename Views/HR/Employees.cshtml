@model IEnumerable<ERP.Models.Employee>

<div class="container py-5">

    <div class="card shadow-lg border-0 rounded-4">

        <!-- Header -->
        <div class="card-header bg-gradient text-white p-4 rounded-top-4 d-flex justify-content-between align-items-center" style="background: linear-gradient(90deg, #1e3c72, #2a5298);">
            <h4 class="mb-0">
                <i class="bi bi-people-fill me-2"></i> Employees
            </h4>
            <a asp-action="Dashboard" class="btn btn-light btn-sm shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back To Dashboard
            </a>
        </div>


        <!-- Body -->
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <i class="bi bi-person text-primary me-2"></i>Employee
                            </th>
                            <th>
                                <i class="bi bi-envelope text-primary me-2"></i>Email
                            </th>
                            <th>
                                <i class="bi bi-diagram-3-fill text-primary me-2"></i>Department
                            </th>
                            <th>
                                <i class="bi bi-cash-stack text-primary me-2"></i>Salary
                            </th>
                            <th class="text-center">
                                <i class="bi bi-gear text-primary me-2"></i>Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var e in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@e.FirstName @e.LastName</td>
                                    <td>
                                        <a href="mailto:@e.Email" class="text-decoration-none">
                                            @e.Email
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark px-3 py-2">
                                            @e.Department?.DepartmentName
                                        </span>
                                    </td>
                                    <td class="text-success fw-bold">₹ @e.Salary.ToString("N2")</td>
                                    <td class="text-center">
                                        <a asp-action="GeneratePayroll"
                                           asp-route-employeeId="@e.EmployeeId"
                                           class="btn btn-sm btn-success shadow-sm me-2"
                                           title="Generate Payroll">
                                            <i class="bi bi-cash-stack me-1"></i> Generate
                                        </a>

                                        <a asp-action="GetPayrollByEmployee"
                                           asp-route-employeeId="@e.EmployeeId"
                                           class="btn btn-sm btn-primary shadow-sm"
                                           title="View Payroll">
                                            <i class="bi bi-eye me-1"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-4 me-2"></i>No employees found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="card-footer bg-light text-center text-muted small p-3">
            &copy; @DateTime.UtcNow.Year Your Company Name. All Rights Reserved.
        </div>
    </div>
</div>

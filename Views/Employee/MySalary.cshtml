@model IEnumerable<ERP.Models.PayRoll>

@{
    ViewData["Title"] = "My Salary";
}

<div class="container-fluid py-4 py-md-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="page-icon">
                <i class="bi bi-wallet2"></i>
            </div>

            <div>

                <h2 class="fw-bold mb-1">
                    My Salary
                </h2>

                <p class="text-muted mb-0">
                    View your payroll and salary details.
                </p>

            </div>

        </div>


        <a asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>
            Dashboard

        </a>

    </div>


    @if (Model.Any())
    {

        var latestPayroll = Model
        .OrderByDescending(x => x.GeneratedDate)
        .First();


        <!-- Salary Summary -->
        <div class="row g-4 mb-4">

            <!-- Basic -->
            <div class="col-12 col-md-4">

                <div class="salary-summary-card">

                    <div class="salary-summary-icon basic">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div>

                        <small class="text-muted">
                            Basic Salary
                        </small>

                        <h4 class="fw-bold mb-0">
                            ₹ @latestPayroll.BasicSalary.ToString("N2")
                        </h4>

                    </div>

                </div>

            </div>


            <!-- Allowances -->
            <div class="col-12 col-md-4">

                <div class="salary-summary-card">

                    <div class="salary-summary-icon allowance">
                        <i class="bi bi-plus-circle-fill"></i>
                    </div>

                    <div>

                        <small class="text-muted">
                            Allowances
                        </small>

                        <h4 class="fw-bold mb-0 text-success">
                            ₹ @latestPayroll.Allowances.ToString("N2")
                        </h4>

                    </div>

                </div>

            </div>


            <!-- Net Salary -->
            <div class="col-12 col-md-4">

                <div class="salary-summary-card">

                    <div class="salary-summary-icon net">
                        <i class="bi bi-wallet-fill"></i>
                    </div>

                    <div>

                        <small class="text-muted">
                            Net Salary
                        </small>

                        <h4 class="fw-bold mb-0 text-primary">
                            ₹ @latestPayroll.NetSalary.ToString("N2")
                        </h4>

                    </div>

                </div>

            </div>

        </div>


        <!-- Payroll Table -->
        <div class="card payroll-card border-0 shadow-sm">

            <div class="card-header payroll-header border-0">

                <div class="d-flex align-items-center">

                    <div class="table-icon me-3">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <div>

                        <h5 class="fw-bold mb-0">
                            Payroll History
                        </h5>

                        <small class="text-muted">
                            Your generated salary records
                        </small>

                    </div>

                </div>

            </div>


            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    Generated Date
                                </th>

                                <th>
                                    Basic Salary
                                </th>

                                <th>
                                    Allowances
                                </th>

                                <th>
                                    Deductions
                                </th>

                                <th>
                                    Net Salary
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model.OrderByDescending(x => x.GeneratedDate))
                            {

                                <tr>

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="date-icon">

                                                <i class="bi bi-calendar-event"></i>

                                            </div>

                                            <span class="fw-semibold">
                                                @item.GeneratedDate.ToString("dd MMM yyyy")
                                            </span>

                                        </div>

                                    </td>


                                    <td>
                                        ₹ @item.BasicSalary.ToString("N2")
                                    </td>


                                    <td class="text-success fw-semibold">
                                        + ₹ @item.Allowances.ToString("N2")
                                    </td>


                                    <td class="text-danger fw-semibold">
                                        - ₹ @item.Deductions.ToString("N2")
                                    </td>


                                    <td>

                                        <span class="net-salary">

                                            ₹ @item.NetSalary.ToString("N2")

                                        </span>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>


            <div class="card-footer bg-light border-0 text-muted small">

                <i class="bi bi-info-circle me-1"></i>

                Salary information is generated by the HR department.

            </div>

        </div>

    }
    else
    {

        <!-- Empty -->
        <div class="card border-0 shadow-sm empty-card">

            <div class="card-body text-center py-5">

                <div class="empty-icon">

                    <i class="bi bi-wallet2"></i>

                </div>

                <h4 class="fw-bold mt-3">
                    No Salary Records
                </h4>

                <p class="text-muted">
                    No payroll information is available yet.
                </p>

                <a asp-action="Dashboard"
                   class="btn btn-primary-custom">

                    <i class="bi bi-arrow-left me-2"></i>
                    Back to Dashboard

                </a>

            </div>

        </div>

    }

</div>


<style>

    .page-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg,#1e3c72,#2a5298);
        color: white;
        font-size: 1.3rem;
    }


    .salary-summary-card {
        display: flex;
        align-items: center;
        gap: 16px;
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,.06);
        height: 100%;
    }


    .salary-summary-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.25rem;
    }


    .basic {
        background: #eef3ff;
        color: #2a5298;
    }


    .allowance {
        background: #e8f8ef;
        color: #198754;
    }


    .net {
        background: #e8efff;
        color: #1e3c72;
    }


    .payroll-card {
        border-radius: 18px;
        overflow: hidden;
    }


    .payroll-header {
        background: white;
        padding: 20px;
    }


    .table-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef3ff;
        color: #2a5298;
        border-radius: 10px;
    }


    .table thead {
        background: #f7f9fc;
    }


        .table thead th {
            padding: 15px;
            font-size: .85rem;
            color: #475467;
            white-space: nowrap;
        }


    .table tbody td {
        padding: 16px;
        white-space: nowrap;
    }


    .date-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #eef3ff;
        color: #2a5298;
    }


    .net-salary {
        background: #e8f8ef;
        color: #198754;
        padding: 7px 12px;
        border-radius: 20px;
        font-weight: 700;
    }


    .empty-card {
        border-radius: 18px;
    }


    .empty-icon {
        width: 70px;
        height: 70px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eef3ff;
        color: #2a5298;
        font-size: 1.8rem;
    }


    .btn-primary-custom {
        color: white;
        border: none;
        background: linear-gradient(90deg,#1e3c72,#2a5298);
        border-radius: 8px;
        font-weight: 600;
        padding: 9px 16px;
    }


        .btn-primary-custom:hover {
            color: white;
            box-shadow: 0 8px 18px rgba(30,60,114,.2);
        }


    @@media(max-width:576px) {

        .page-icon {
            width: 45px;
            height: 45px;
            min-width: 45px;
        }
    }

</style>
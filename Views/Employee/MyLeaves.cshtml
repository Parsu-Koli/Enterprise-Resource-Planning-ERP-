@model IEnumerable<ERP.Models.Leave>

@{
    ViewData["Title"] = "My Leaves";
}

<div class="container-fluid py-4 py-md-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="page-icon">
                <i class="bi bi-calendar-check-fill"></i>
            </div>

            <div>

                <h2 class="fw-bold mb-1">
                    My Leaves
                </h2>

                <p class="text-muted mb-0">
                    Track your leave requests and approval status.
                </p>

            </div>

        </div>


        <a asp-action="ApplyLeave"
           class="btn btn-primary-custom">

            <i class="bi bi-plus-circle me-2"></i>
            Apply New Leave

        </a>

    </div>


    <!-- Table Card -->
    <div class="card border-0 shadow-sm leave-table-card">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th class="ps-4">
                                Leave Type
                            </th>

                            <th>
                                From
                            </th>

                            <th>
                                To
                            </th>

                            <th>
                                Reason
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Applied Date
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {

                            @foreach (var item in Model)
                            {

                                <tr>

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="leave-type-icon">
                                                <i class="bi bi-calendar-event"></i>
                                            </div>

                                            <span class="fw-semibold">
                                                @item.LeaveType
                                            </span>

                                        </div>

                                    </td>


                                    <td>
                                        @item.FromDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        @item.ToDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td>

                                        <span class="reason-text"
                                              title="@item.Reason">

                                            @item.Reason

                                        </span>

                                    </td>


                                    <td>

                                        @if (item.Status == "Approved")
                                        {

                                            <span class="status-badge approved">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Approved

                                            </span>

                                        }
                                        else if (item.Status == "Rejected")
                                        {

                                            <span class="status-badge rejected">

                                                <i class="bi bi-x-circle-fill"></i>

                                                Rejected

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="status-badge pending">

                                                <i class="bi bi-clock-fill"></i>

                                                Pending

                                            </span>

                                        }

                                    </td>


                                    <td>
                                        @item.AppliedDate.ToString("dd MMM yyyy")
                                    </td>

                                </tr>

                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="6">

                                    <div class="empty-state">

                                        <div class="empty-icon">

                                            <i class="bi bi-calendar-x"></i>

                                        </div>

                                        <h5 class="fw-bold mt-3">
                                            No Leave Requests
                                        </h5>

                                        <p class="text-muted">
                                            You have not submitted any leave requests yet.
                                        </p>

                                        <a asp-action="ApplyLeave"
                                           class="btn btn-primary-custom">

                                            <i class="bi bi-plus-circle me-2"></i>
                                            Apply Leave

                                        </a>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- Footer -->
        <div class="card-footer bg-light border-0 text-muted small">

            <i class="bi bi-info-circle me-1"></i>

            Leave requests are reviewed by the HR department.

        </div>

    </div>

</div>


<style>

    .page-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg,#1e3c72,#2a5298);
        color: white;
        font-size: 1.3rem;
    }


    .leave-table-card {
        border-radius: 18px;
        overflow: hidden;
    }


    .table thead {
        background: #f7f9fc;
    }


        .table thead th {
            color: #475467;
            font-size: .85rem;
            font-weight: 700;
            white-space: nowrap;
            padding: 16px;
        }


    .table tbody td {
        padding: 16px;
    }


    .leave-type-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef3ff;
        color: #2a5298;
        border-radius: 9px;
    }


    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 600;
        white-space: nowrap;
    }


    .approved {
        background: #e8f8ef;
        color: #198754;
    }


    .rejected {
        background: #ffe9ed;
        color: #dc3545;
    }


    .pending {
        background: #fff4db;
        color: #a66b00;
    }


    .reason-text {
        display: block;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #667085;
    }


    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }


    .empty-icon {
        width: 70px;
        height: 70px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef3ff;
        color: #2a5298;
        border-radius: 50%;
        font-size: 1.8rem;
    }


    .btn-primary-custom {
        color: white;
        border: none;
        background: linear-gradient(90deg,#1e3c72,#2a5298);
        border-radius: 8px;
        font-weight: 600;
        padding: 9px 16px;
    }


        .btn-primary-custom:hover {
            color: white;
            box-shadow: 0 8px 18px rgba(30,60,114,.2);
        }


    @@media(max-width:576px) {

        .page-icon {
            width: 45px;
            height: 45px;
            min-width: 45px;
        }
    }

</style>
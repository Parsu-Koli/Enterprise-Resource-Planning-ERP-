@model ERP.Models.Employee

@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid py-4 py-md-5">

    <!-- Profile Header -->
    <div class="row justify-content-center">

        <div class="col-12 col-xl-10">

            <div class="profile-card border-0 shadow-lg">

                <!-- Cover -->
                <div class="profile-cover">

                    <div class="profile-avatar">

                        <i class="bi bi-person-fill"></i>

                    </div>

                </div>


                <!-- Profile Header Content -->
                <div class="profile-header-content">

                    <div>

                        <h2 class="fw-bold mb-1">
                            @Model.FirstName @Model.LastName
                        </h2>

                        <p class="text-muted mb-2">
                            <i class="bi bi-briefcase me-1"></i>
                            @Model.Designation
                        </p>

                        <span class="department-badge">

                            <i class="bi bi-diagram-3-fill me-1"></i>

                            @Model.Department?.DepartmentName

                        </span>

                    </div>


                    <a asp-action="Dashboard"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-2"></i>
                        Dashboard

                    </a>

                </div>


                <!-- Information -->
                <div class="profile-body">

                    <!-- Personal -->
                    <div class="profile-section">

                        <div class="section-title">

                            <i class="bi bi-person-vcard-fill"></i>

                            Personal Information

                        </div>


                        <div class="row g-3 mt-1">

                            <div class="col-12 col-md-6">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>
                                        <small>First Name</small>
                                        <strong>@Model.FirstName</strong>
                                    </div>

                                </div>

                            </div>


                            <div class="col-12 col-md-6">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>
                                        <small>Last Name</small>
                                        <strong>@Model.LastName</strong>
                                    </div>

                                </div>

                            </div>


                            <div class="col-12 col-md-6">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-envelope"></i>
                                    </div>

                                    <div>
                                        <small>Email</small>

                                        <strong>
                                            <a href="mailto:@Model.Email">
                                                @Model.Email
                                            </a>
                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <div class="col-12 col-md-6">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-phone"></i>
                                    </div>

                                    <div>
                                        <small>Phone</small>
                                        <strong>@Model.Phone</strong>
                                    </div>

                                </div>

                            </div>


                            <div class="col-12 col-md-6">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-gender-ambiguous"></i>
                                    </div>

                                    <div>
                                        <small>Gender</small>
                                        <strong>@Model.Gender</strong>
                                    </div>

                                </div>

                            </div>


                            <div class="col-12 col-md-6">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-calendar-event"></i>
                                    </div>

                                    <div>
                                        <small>Date of Birth</small>
                                        <strong>
                                            @Model.BirthDate.ToString("dd MMM yyyy")
                                        </strong>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4">


                    <!-- Professional -->
                    <div class="profile-section">

                        <div class="section-title">

                            <i class="bi bi-briefcase-fill"></i>

                            Professional Information

                        </div>


                        <div class="row g-3 mt-1">

                            <div class="col-12 col-md-4">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-hash"></i>
                                    </div>

                                    <div>
                                        <small>Employee ID</small>
                                        <strong>#@Model.EmployeeId</strong>
                                    </div>

                                </div>

                            </div>


                            <div class="col-12 col-md-4">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-diagram-3"></i>
                                    </div>

                                    <div>
                                        <small>Department</small>
                                        <strong>
                                            @Model.Department?.DepartmentName
                                        </strong>
                                    </div>

                                </div>

                            </div>


                            <div class="col-12 col-md-4">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-briefcase"></i>
                                    </div>

                                    <div>
                                        <small>Designation</small>
                                        <strong>
                                            @Model.Designation
                                        </strong>
                                    </div>

                                </div>

                            </div>


                            <div class="col-12 col-md-6">

                                <div class="salary-box">

                                    <div class="salary-icon">
                                        <i class="bi bi-cash-stack"></i>
                                    </div>

                                    <div>

                                        <small>Current Salary</small>

                                        <h4 class="mb-0 fw-bold">
                                            ₹ @Model.Salary.ToString("N2")
                                        </h4>

                                    </div>

                                </div>

                            </div>


                            <div class="col-12 col-md-6">

                                <div class="info-item">

                                    <div class="info-icon">
                                        <i class="bi bi-calendar-check"></i>
                                    </div>

                                    <div>
                                        <small>Date of Joining</small>

                                        <strong>
                                            @Model.DateOfJoining.ToString("dd MMM yyyy")
                                        </strong>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Resume -->
                    @if (!string.IsNullOrEmpty(ViewBag.ResumePath))
                    {

                        <hr class="my-4">

                        <div class="resume-box">

                            <div class="resume-icon">

                                <i class="bi bi-file-earmark-pdf-fill"></i>

                            </div>

                            <div class="flex-grow-1">

                                <h6 class="fw-bold mb-1">
                                    Resume / CV
                                </h6>

                                <small class="text-muted">
                                    View your uploaded resume.
                                </small>

                            </div>

                            <a href="@ViewBag.ResumePath"
                               target="_blank"
                               class="btn btn-outline-danger">

                                <i class="bi bi-eye me-1"></i>
                                View

                            </a>

                        </div>

                    }

                </div>


                <!-- Footer -->
                <div class="profile-footer">

                    <i class="bi bi-shield-check me-1"></i>

                    Employee information is securely maintained by the ERP system.

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    .profile-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
    }


    .profile-cover {
        height: 150px;
        background: linear-gradient( 135deg, #1e3c72, #2a5298 );
        position: relative;
    }


    .profile-avatar {
        position: absolute;
        left: 50px;
        bottom: -42px;
        width: 84px;
        height: 84px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: white;
        color: #2a5298;
        font-size: 2.3rem;
        border: 5px solid white;
        box-shadow: 0 5px 20px rgba(0,0,0,.15);
    }


    .profile-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 60px 40px 25px;
    }


    .department-badge {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        background: #eef3ff;
        color: #2a5298;
        font-size: .8rem;
        font-weight: 600;
    }


    .profile-body {
        padding: 20px 40px 35px;
    }


    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #1e3c72;
        font-weight: 700;
        font-size: 1.05rem;
    }


    .info-item {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px;
        background: #f8faff;
        border-radius: 12px;
        height: 100%;
    }


    .info-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8efff;
        color: #2a5298;
        border-radius: 10px;
    }


    .info-item small {
        display: block;
        color: #98a2b3;
        margin-bottom: 3px;
    }


    .info-item strong {
        display: block;
        color: #344054;
        word-break: break-word;
    }


    .info-item a {
        color: #2a5298;
        text-decoration: none;
    }


    .salary-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 16px;
        border-radius: 12px;
        background: #e8f8ef;
        color: #198754;
        height: 100%;
    }


    .salary-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: white;
        font-size: 1.2rem;
    }


    .resume-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        border-radius: 14px;
        background: #fff5f5;
    }


    .resume-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #ffe9ed;
        color: #dc3545;
        font-size: 1.2rem;
    }


    .profile-footer {
        background: #f8f9fc;
        padding: 15px;
        text-align: center;
        color: #667085;
        font-size: .8rem;
    }


    @@media(max-width:576px) {

        .profile-cover {
            height: 120px;
        }

        .profile-avatar {
            left: 25px;
            width: 75px;
            height: 75px;
        }

        .profile-header-content {
            padding: 55px 20px 20px;
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .profile-body {
            padding: 15px 20px 25px;
        }
    }

</style>
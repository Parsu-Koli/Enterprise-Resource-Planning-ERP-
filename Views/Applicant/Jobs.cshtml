@model IEnumerable<ERP.Models.JobOpening>

@{
    ViewData["Title"] = "Job Openings";
}

<div class="container-fluid py-4 py-md-5">

    <!-- ================================
         PAGE HEADER
         ================================= -->

    <div class="row align-items-center mb-4">

        <div class="col-12 col-md-8">

            <div class="d-flex align-items-center gap-3">

                <div class="page-icon">
                    <i class="bi bi-briefcase-fill"></i>
                </div>

                <div>
                    <h2 class="fw-bold mb-1">
                        Available Jobs
                    </h2>

                    <p class="text-muted mb-0">
                        Explore career opportunities and apply for your desired position.
                    </p>
                </div>

            </div>

        </div>


        <!-- Job Count -->

        <div class="col-12 col-md-4 mt-3 mt-md-0">

            <div class="job-count-card ms-md-auto">

                <div class="count-icon">
                    <i class="bi bi-briefcase"></i>
                </div>

                <div>
                    <span class="small text-muted">
                        Available Positions
                    </span>

                    <h5 class="mb-0 fw-bold">
                        @Model.Count()
                    </h5>
                </div>

            </div>

        </div>

    </div>


    <!-- ================================
         JOB LIST
         ================================= -->
    @if (Model.Any())
    {

        <div class="row g-4">

            @foreach (var job in Model)
            {

                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card job-card border-0 shadow-sm h-100">

                        <!-- Top Section -->

                        <div class="job-card-header">

                            <div class="job-icon">
                                <i class="bi bi-building"></i>
                            </div>

                            <span class="job-status">
                                <i class="bi bi-circle-fill me-1"></i>
                                Open
                            </span>

                        </div>


                        <!-- Body -->

                        <div class="card-body p-4">

                            <h4 class="job-title">
                                @job.JobTitle
                            </h4>


                            <!-- Experience -->

                            <div class="job-detail">

                                <div class="detail-icon">
                                    <i class="bi bi-briefcase"></i>
                                </div>

                                <div>
                                    <small class="text-muted d-block">
                                        Experience Required
                                    </small>

                                    <strong>
                                        @job.ExperienceRequired years
                                    </strong>
                                </div>

                            </div>


                            <!-- Description -->

                            <div class="mt-4">

                                <h6 class="fw-bold">
                                    <i class="bi bi-file-text me-2 text-primary"></i>
                                    Job Description
                                </h6>

                                <p class="text-muted job-description">

                                    @if (!string.IsNullOrWhiteSpace(job.Description))
                                    {
                                        @job.Description
                                    }
                                    else
                                    {
                                        <span>
                                            No description provided for this position.
                                        </span>
                                    }

                                </p>

                            </div>

                        </div>


                        <!-- Footer -->

                        <div class="card-footer bg-white border-0 p-4 pt-0">

                            <a asp-action="Apply"
                               asp-route-jobId="@job.JobId"
                               class="btn btn-apply w-100">

                                <i class="bi bi-send-fill me-2"></i>

                                Apply Now

                                <i class="bi bi-arrow-right ms-2"></i>

                            </a>

                        </div>

                    </div>

                </div>

            }

        </div>

    }
    else
    {

        <!-- ================================
             NO JOBS
             ================================= -->

        <div class="card border-0 shadow-sm empty-card">

            <div class="card-body text-center py-5">

                <div class="empty-icon">

                    <i class="bi bi-briefcase"></i>

                </div>

                <h4 class="fw-bold mt-3">
                    No Job Openings
                </h4>

                <p class="text-muted mb-0">
                    There are currently no available job positions.
                    Please check again later.
                </p>

            </div>

        </div>

    }

</div>


<style>

    /* =========================================
           PAGE ICON
           ========================================= */

    .page-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient( 135deg, #1e3c72, #2a5298 );
        color: white;
        font-size: 1.3rem;
        box-shadow: 0 8px 20px rgba(30,60,114,0.20);
    }


    /* =========================================
           JOB COUNT
           ========================================= */

    .job-count-card {
        display: flex;
        align-items: center;
        gap: 12px;
        width: fit-content;
        padding: 12px 18px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.06);
    }

    .count-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eef3ff;
        color: #2a5298;
    }


    /* =========================================
           JOB CARD
           ========================================= */

    .job-card {
        border-radius: 18px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .job-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 15px 35px rgba(30,60,114,0.12) !important;
        }


    /* =========================================
           JOB HEADER
           ========================================= */

    .job-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px;
        background: linear-gradient( 135deg, #1e3c72, #2a5298 );
    }


    .job-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: rgba(255,255,255,0.15);
        color: white;
        font-size: 1.3rem;
    }


    .job-status {
        background: rgba(255,255,255,0.15);
        color: white;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .job-status i {
            font-size: 6px;
        }


    /* =========================================
           JOB TITLE
           ========================================= */

    .job-title {
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 20px;
        line-height: 1.3;
    }


    /* =========================================
           JOB DETAIL
           ========================================= */

    .job-detail {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: #f8faff;
        border-radius: 10px;
    }


    .detail-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #e8efff;
        color: #2a5298;
    }


    /* =========================================
           DESCRIPTION
           ========================================= */

    .job-description {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.6;
        min-height: 100px;
    }


    /* =========================================
           APPLY BUTTON
           ========================================= */

    .btn-apply {
        border: none;
        border-radius: 9px;
        padding: 11px 18px;
        font-weight: 600;
        color: white;
        background: linear-gradient( 90deg, #1e3c72, #2a5298 );
        transition: all 0.25s ease;
    }


        .btn-apply:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(30,60,114,0.25);
        }


    /* =========================================
           EMPTY STATE
           ========================================= */

    .empty-card {
        border-radius: 18px;
    }


    .empty-icon {
        width: 75px;
        height: 75px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eef3ff;
        color: #2a5298;
        font-size: 2rem;
    }


    /* =========================================
           MOBILE RESPONSIVE
           ========================================= */

    @@media (max-width: 576px) {

        .page-icon {
            width: 45px;
            height: 45px;
            min-width: 45px;
            font-size: 1.1rem;
        }


        .job-count-card {
            width: 100%;
        }


        .job-card-header {
            padding: 16px;
        }


        .job-card .card-body {
            padding: 20px !important;
        }


        .job-title {
            font-size: 1.2rem;
        }
    }

</style>
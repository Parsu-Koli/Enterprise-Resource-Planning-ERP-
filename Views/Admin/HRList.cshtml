@model IEnumerable<ERP.Models.HRModel>

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-person-badge-fill text-primary me-2"></i>
            HR Management
        </h2>
        <a asp-action="CreateHr" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add HR
        </a>
    </div>

    <!-- Card Wrapper -->
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <i class="bi bi-person text-primary me-2"></i>Name
                            </th>
                            <th>
                                <i class="bi bi-envelope text-primary me-2"></i>Email
                            </th>
                            <th>
                                <i class="bi bi-mortarboard text-primary me-2"></i>Qualification
                            </th>
                            <th>
                                <i class="bi bi-briefcase text-primary me-2"></i>Experience
                            </th>
                            <th>
                                <i class="bi bi-file-text text-primary me-2"></i>Resume
                            </th>
                            <th class="text-center">
                                <i class="bi bi-gear text-primary me-2"></i>Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var hr in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @hr.FirstName @hr.LastName
                                    </td>

                                    <td class="text-muted">
                                        <a href="mailto:@hr.User?.Email" class="text-decoration-none">
                                            @hr.User?.Email
                                        </a>
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark px-3 py-2">
                                            @hr.Qualification
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary px-3 py-2">
                                            @hr.Experience Years
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(hr.ResumePath))
                                        {
                                            <a href="@hr.ResumePath"
                                               target="_blank"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-file-earmark-pdf me-1"></i>View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <!-- Edit Button -->
                                        <a asp-action="UpdateHr"
                                           asp-route-id="@hr.Id"
                                           class="btn btn-outline-warning btn-sm me-2"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Delete Button -->
                                        <form asp-controller="Admin"
                                              asp-action="DeleteHR"
                                              asp-route-id="@hr.UserId"
                                              method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Are you sure you want to delete this HR?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-4 me-2"></i>No HR records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>
    </div>

</div>

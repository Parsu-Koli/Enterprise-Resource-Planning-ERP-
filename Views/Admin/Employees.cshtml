@model IEnumerable<ERP.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid py-4 px-3 px-lg-4">

    <div class="mb-4">

        <span class="text-primary small fw-semibold text-uppercase">
            Workforce
        </span>

        <h2 class="fw-bold mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>
            Employees
        </h2>

        <p class="text-muted mb-0">
            View and manage all employees in the organization.
        </p>

    </div>


    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        Employee Directory
                    </h5>

                    <small class="text-muted">
                        @Model.Count() employee(s)
                    </small>
                </div>

                <div class="employee-count">
                    <i class="bi bi-people-fill me-1"></i>
                    @Model.Count()
                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4">Employee</th>

                            <th>Email</th>

                            <th>Department</th>

                            <th>Salary</th>

                            <th class="text-center">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var e in Model)
                            {
                                <tr>

                                    <td class="px-4">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="employee-avatar">
                                                @e.FirstName?.Substring(0, 1).ToUpper()
                                            </div>

                                            <div>
                                                <div class="fw-semibold">
                                                    @e.FirstName @e.LastName
                                                </div>

                                                <small class="text-muted">
                                                    Employee #@e.EmployeeId
                                                </small>
                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        <a href="mailto:@e.Email"
                                           class="text-decoration-none">

                                            <i class="bi bi-envelope me-1"></i>
                                            @e.Email

                                        </a>
                                    </td>

                                    <td>

                                        <span class="badge bg-primary-subtle text-primary px-3 py-2">

                                            <i class="bi bi-diagram-3 me-1"></i>

                                            @e.Department?.DepartmentName

                                        </span>

                                    </td>

                                    <td>

                                        <span class="fw-bold text-success">

                                            ₹ @e.Salary.ToString("N2")

                                        </span>

                                    </td>

                                    <td class="text-center">

                                        <form asp-controller="Admin"
                                              asp-action="DeleteUsers"
                                              asp-route-id="@e.EmployeeId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this employee?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5">

                                    <div class="empty-state">

                                        <i class="bi bi-people"></i>

                                        <h5>No Employees Found</h5>

                                        <p class="text-muted mb-0">
                                            There are currently no employees.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<style>

    .employee-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #e8efff;
        color: #1e3c72;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .employee-count {
        background: #e8efff;
        color: #1e3c72;
        padding: 8px 14px;
        border-radius: 10px;
        font-weight: 600;
    }

    .empty-state {
        padding: 50px 20px;
        text-align: center;
    }

        .empty-state i {
            font-size: 45px;
            color: #adb5bd;
        }

    @@media(max - width:768px) {
        .table

    {
        min-width: 800px;
    }

    }
</style>